# Copy to .env and fill in. The server reads these on startup.

# --- Network ---
JARVIZ_HTTP_HOST=0.0.0.0
JARVIZ_HTTP_PORT=8080
# Public WebSocket URL the device should connect to. The OTA response hands
# this to the device verbatim. For LAN dev, use ws://<your-host-LAN-IP>:8080/xiaozhi/v1/.
# In production behind a TLS terminator, use wss://jarviz.example.com/xiaozhi/v1/.
JARVIZ_WS_PUBLIC_URL=ws://192.168.1.100:8080/xiaozhi/v1/

# Minutes east of UTC, applied by the device to its system clock at OTA time.
# Example: -240 = EDT, -300 = EST, 480 = China, 0 = UTC. The board sets TZ=UTC0
# and treats this as wall-clock seconds, so reminders fire at the right local time.
JARVIZ_TZ_OFFSET_MINUTES=-240

# --- LLM ---
# Provider: "deepseek" (OpenAI-compatible, default) or "anthropic".
JARVIZ_LLM_PROVIDER=deepseek
JARVIZ_LLM_MODEL=deepseek-v4-flash
JARVIZ_LLM_MAX_TOKENS=512

# DeepSeek (https://platform.deepseek.com). OpenAI-compatible Chat Completions.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Generic OpenAI-compatible provider (only used when JARVIZ_LLM_PROVIDER=openai).
# Leave OPENAI_BASE_URL empty to default to https://api.openai.com.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Anthropic (only used when JARVIZ_LLM_PROVIDER=anthropic).
ANTHROPIC_API_KEY=

# --- ASR ---
# "faster_whisper" runs locally (CPU works, GPU faster). Model size: tiny|base|small|medium|large-v3.
# Tiny is enough for short reminder phrases; Small if you need better accuracy.
JARVIZ_ASR_PROVIDER=faster_whisper
JARVIZ_WHISPER_MODEL=small
JARVIZ_WHISPER_DEVICE=cpu
JARVIZ_WHISPER_COMPUTE_TYPE=int8
# Max concurrent ASR inferences. faster-whisper's underlying CTranslate2
# Generator is NOT thread-safe per-model, so the default 1 serializes all
# transcribes through one model. Raising > 1 requires a separate model
# pool (not yet implemented) - leave at 1 unless you've built one.
JARVIZ_ASR_PARALLELISM=1

# --- TTS (Edge TTS — free Microsoft voices) ---
# Voice list: `edge-tts --list-voices`. en-US-GuyNeural is a calm male voice that
# fits the "butler" persona; en-US-AriaNeural / en-GB-RyanNeural also work well.
JARVIZ_TTS_VOICE=en-US-GuyNeural
JARVIZ_TTS_RATE=+0%

# --- Storage ---
# Where the device registry / per-device user data is persisted. Created if missing.
JARVIZ_DATA_DIR=./data

# --- Logging ---
JARVIZ_LOG_LEVEL=INFO

# --- Auth (optional) ---
# Shared HMAC secret for per-device tokens. Empty = unauthenticated (LAN-only
# prototype default). Set this to any random string (e.g. `openssl rand -hex 32`)
# to require devices to present a valid OTA-minted bearer token on WS connect.
# The token format matches xinnan-tech/xiaozhi-esp32-server so any Jarviz
# firmware built against either backend interoperates.
JARVIZ_AUTH_SECRET=
# How long a freshly-minted OTA token is accepted by the WS endpoint (seconds).
# 30 days mirrors the upstream community server's default.
JARVIZ_AUTH_TOKEN_TTL_S=2592000
# Comma-separated allowlist of device-ids that skip auth entirely (e.g. dev
# boards). Devices on this list get an empty OTA token and bypass WS check.
JARVIZ_AUTH_ALLOWED_DEVICES=

# --- Resource limits ---
# Hard cap on simultaneous WebSocket sessions. Idle WS connections are cheap;
# this exists to prevent a buggy device in a reboot loop or a hostile caller
# from monopolizing the process. For fleet deployments raise to your expected
# fleet size plus headroom (e.g. 300 for 200 devices).
JARVIZ_MAX_SESSIONS=64

# Hard cap on concurrently-running pipeline turns (ASR + LLM + TTS). This is
# what actually bounds CPU and provider quota at any instant. Turns over this
# cap wait briefly (JARVIZ_TURN_QUEUE_TIMEOUT_S) for a slot; if still full,
# they send a polite "I'm overloaded" reply. Raise on a GPU host or once a
# Whisper model pool is in place.
JARVIZ_MAX_CONCURRENT_TURNS=8
JARVIZ_TURN_QUEUE_TIMEOUT_S=5.0

# Per-device reconnect cooldown. A given Device-Id can only open a new WS
# or hit OTA once every this many seconds; faster reconnects get 429
# (OTA) or 1008 (WS). Set to 0 to disable. Protects against reboot-loop
# devices burning LLM/quota budget.
JARVIZ_DEVICE_COOLDOWN_S=2.0

# WebSocket keepalive. With these set, a client that vanishes (TCP RST,
# power-cycled device, dropped Wi-Fi) is detected within roughly
# ping_interval + ping_timeout seconds and its session slot freed. Tighter
# values catch dead clients sooner but cost more ping traffic and risk
# closing on a brief network blip; 20/20 are uvicorn's own defaults.
JARVIZ_WS_PING_INTERVAL_S=20.0
JARVIZ_WS_PING_TIMEOUT_S=20.0
